---
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const title = "Reda Salmi - Frontend Engineer";
const description =
  "Reda Salmi is a frontend engineer specializing in Shopify, TypeScript, accessible interfaces, and high-traffic storefronts.";
const siteURL = Astro.site ?? new URL("https://redacodes.com");
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const previewImage = new URL("/preview.jpg", siteURL);
const previewImageAlt = "Reda Salmi frontend engineer portfolio homepage";
const twitterUsername = "@redsalmi";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteURL.href}#website`,
      url: siteURL.href,
      name: "Reda Codes",
      alternateName: "Reda Salmi Portfolio",
    },
    {
      "@type": "ProfilePage",
      "@id": `${siteURL.href}#webpage`,
      url: canonicalURL.href,
      name: title,
      description,
      isPartOf: { "@id": `${siteURL.href}#website` },
      mainEntity: { "@id": `${siteURL.href}#person` },
    },
    {
      "@type": "Person",
      "@id": `${siteURL.href}#person`,
      name: "Reda Salmi",
      jobTitle: "Frontend Engineer",
      url: siteURL.href,
      sameAs: [
        "https://github.com/redasalmi",
        "https://www.linkedin.com/in/reda-salmi-424a30168/",
        "https://x.com/redsalmi",
      ],
      knowsAbout: ["Shopify", "TypeScript", "Frontend engineering"],
    },
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content="Reda Salmi" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Reda Codes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:alt" content={previewImageAlt} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterUsername} />
    <meta name="twitter:creator" content={twitterUsername} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImage} />
    <meta name="twitter:image:alt" content={previewImageAlt} />

    <Font cssVariable="--font-ibm-plex-mono" />
    <Font cssVariable="--font-space-mono" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

    <script is:inline>
      (() => {
        const key = "theme";
        let savedTheme = null;

        try {
          savedTheme = localStorage.getItem(key);
        } catch {
          // localStorage is not available, e.g. in private browsing mode
        }

        const systemTheme = matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
        const theme =
          savedTheme === "light" || savedTheme === "dark"
            ? savedTheme
            : systemTheme;

        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="bg-background type-body text-foreground">
    <a
      href="#main-content"
      class="fixed inset-s-4 top-4 z-50 -translate-y-20 bg-foreground px-4 py-3 type-label text-background focus:translate-y-0"
    >
      Skip to main content
    </a>

    <div
      class="mx-auto min-h-screen w-full max-w-375 md:border-x md:border-border"
    >
      <Header />
      <main id="main-content">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
