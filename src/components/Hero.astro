---
const startedAt = new Date("2019-12-01T00:00:00Z");
const today = new Date();

let years = today.getUTCFullYear() - startedAt.getUTCFullYear();

const anniversaryHasPassed =
  today.getUTCMonth() > startedAt.getUTCMonth() ||
  (today.getUTCMonth() === startedAt.getUTCMonth() &&
    today.getUTCDate() >= startedAt.getUTCDate());

if (!anniversaryHasPassed) years--;
---

<section
  id="hero"
  class="border-b border-border px-page pt-14 pb-[clamp(3rem,5vw,4.5rem)] md:pt-[clamp(4rem,7vw,6.5rem)]"
>
  <div class="flex flex-col gap-14">
    <div class="flex flex-col gap-5">
      <p class="type-label text-muted">
        Frontend Engineer · Self-proclaimed legend
      </p>
      <h1 class="flex flex-col type-display">
        <span>Reda</span>
        <span
          class="text-background [-webkit-text-stroke:1.5px_var(--color-foreground)]"
          >Salmi</span
        >
      </h1>
    </div>

    <div class="flex flex-col gap-8 md:flex-row md:items-end">
      <div class="max-w-170 md:flex-2">
        <p class="type-lead">
          I build fast, accessible Shopify storefronts and web interfaces that
          respect your time.
        </p>
      </div>

      <div class="flex flex-col gap-1 md:flex-1 md:items-end">
        <p class="type-label text-nowrap text-muted">
          Shopify / UI / TypeScript
        </p>
        <p class="type-label text-nowrap text-muted">
          {years}+ years in production
        </p>
      </div>
    </div>
  </div>
</section>
