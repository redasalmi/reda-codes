---
import SplitSection from "./SplitSection.astro";
---

<SplitSection id="about" name="01 / About">
  <div class="flex flex-col gap-20">
    <div class="flex flex-col gap-14">
      <h2 class="type-heading">
        Engineer first. <br />
        Frontend by choice.
      </h2>
      <p class="max-w-225 type-intro">
        I'm Reda, a self-taught developer who found his place in frontend. I
        enjoy turning complicated problems into clear, accessible interfaces and
        building software that people are happy to use and maintain.
      </p>
    </div>

    <div
      class="grid grid-cols-1 gap-4 border-t border-border pt-4 type-note text-muted md:grid-cols-3"
    >
      <p class="flex flex-col">
        <span class="uppercase">Based</span>
        <span>Algiers, Algeria</span>
      </p>
      <p class="flex flex-col">
        <span class="uppercase">Focus</span>
        <span>Shopify · UI</span>
      </p>
      <p class="flex flex-col">
        <span class="uppercase">Offline</span>
        <span>Linux · Gaming</span>
      </p>
    </div>
  </div>
</SplitSection>
