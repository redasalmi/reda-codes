---
import ThemeToggle from "./ThemeToggle.astro";
---

<header
  class="grid min-h-19 grid-cols-[1fr_auto] items-center border-b border-border px-page md:grid-cols-[1fr_auto_1fr]"
>
  <a href="/" class="type-body font-semibold">
    <span aria-hidden="true" class="text-muted">~/</span>
    reda
  </a>

  <nav class="hidden md:block">
    <ul class="flex items-center gap-[clamp(1rem,2.4vw,2.5rem)]">
      <li>
        <a
          href="#about"
          class="type-label hover:underline hover:underline-offset-4">about</a
        >
      </li>
      <li>
        <a
          href="#experience"
          class="type-label hover:underline hover:underline-offset-4"
          >experience</a
        >
      </li>
      <li>
        <a
          href="#work"
          class="type-label hover:underline hover:underline-offset-4">work</a
        >
      </li>
      <li>
        <a
          href="#find-me"
          class="type-label hover:underline hover:underline-offset-4">find me</a
        >
      </li>
    </ul>
  </nav>

  <div class="justify-self-end">
    <ThemeToggle />
  </div>
</header>
