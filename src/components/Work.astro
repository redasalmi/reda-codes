---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import SplitSection from "./SplitSection.astro";

const projects = (
  await getCollection("projects", ({ data }) => data.featured && !data.draft)
).sort((a, b) => a.data.order - b.data.order);
---

<SplitSection id="work" name="03 / Work">
  <div class="flex flex-col gap-14">
    <h2 class="type-heading">
      Things I made <br />
      because I needed them.
    </h2>

    <div class="grid grid-cols-1 border-t border-border md:grid-cols-2">
      {
        projects.map(
          (
            {
              data: {
                title,
                summary,
                year,
                role,
                stack,
                image,
                website,
                source,
              },
            },
            index,
          ) => (
            <article class="project-card flex min-h-70 flex-col gap-8 p-6 md:min-h-82.5">
              <p class="type-label text-muted">
                P/{String(index + 1).padStart(2, "0")} · {year}
              </p>

              {image ? (
                <figure class="overflow-hidden border border-border bg-foreground">
                  <Image
                    src={image.src}
                    alt={image.alt}
                    widths={[480, 720, 960]}
                    sizes="(min-width: 768px) 40vw, 90vw"
                    loading="lazy"
                    decoding="async"
                    class="aspect-16/10 w-full object-cover object-top transition-transform duration-300 motion-safe:hover:scale-[1.02]"
                  />
                </figure>
              ) : null}

              <div class="flex flex-col gap-4">
                <h3 class="type-title">{title}</h3>
                <p class="max-w-[36ch] type-small text-muted">{summary}</p>
              </div>

              <footer class="mt-auto flex flex-col items-start gap-4 sm:flex-row sm:items-end sm:justify-between">
                <div class="flex flex-col gap-1">
                  <p class="type-note text-muted">{role}</p>
                  {stack.length ? (
                    <p class="type-label">{stack.join(" · ")}</p>
                  ) : null}
                </div>

                <div class="flex flex-wrap gap-x-6 gap-y-3 sm:justify-end">
                  {website ? (
                    <a
                      href={website}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Visit ${title} (opens in a new tab)`}
                      class="type-label hover:underline hover:underline-offset-4"
                    >
                      Visit
                    </a>
                  ) : null}
                  {source ? (
                    <a
                      href={source}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`View ${title} source code (opens in a new tab)`}
                      class="type-label hover:underline hover:underline-offset-4"
                    >
                      Source
                    </a>
                  ) : null}
                </div>
              </footer>
            </article>
          ),
        )
      }
    </div>
  </div>
</SplitSection>

<style>
  .project-card {
    border-bottom: 1px solid var(--color-border);
  }

  .project-card:last-child {
    border-bottom: 0;
  }

  @media (min-width: 48rem) {
    .project-card:nth-child(odd):not(:last-child) {
      border-right: 1px solid var(--color-border);
    }

    .project-card:nth-last-child(2):nth-child(odd) {
      border-bottom: 0;
    }
  }
</style>
