---
import SplitSection from "./SplitSection.astro";
import { experiences } from "../data/experience";
---

<SplitSection id="experience" name="02 / Experience">
  <div class="flex flex-col gap-14">
    <div>
      <h2 id="experience-title" class="type-heading">
        Production <br />
        history.
      </h2>
    </div>
    <div>
      {
        experiences.map(({ company, title, date }) => (
          <article class="grid grid-cols-1 gap-1 border-t border-border py-7 md:grid-cols-[1fr_1fr_auto] md:gap-8">
            <strong class="type-body font-medium">{company}</strong>
            <span class="type-body text-muted">{title}</span>
            <time class="type-body text-muted md:text-right">{date}</time>
          </article>
        ))
      }
    </div>
  </div>
</SplitSection>
